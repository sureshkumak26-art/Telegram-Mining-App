NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mining_app
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
TELEGRAM_WEB_APP_URL=https://your-mini-app.example.com
ADMIN_TELEGRAM_IDS=123456789

# Optional secure Chrome admin login (keep all values on the backend only)
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD_HASH=scrypt$replace_with_32_hex_salt$replace_with_128_hex_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
CLIENT_ORIGIN=http://localhost:5173

# Ethereum Mainnet crypto wallet (keep the RPC URL private on the backend)
ETHEREUM_RPC_URL=
ETHEREUM_DEPOSIT_ADDRESS=
# Legacy alias; deposit address takes precedence
ETHEREUM_TREASURY_ADDRESS=
ETHEREUM_USDC_CONTRACT=

# Backend policy; the withdrawal fee remains fixed at 0.02 ETH
MIN_ETH_WITHDRAWAL_ETH=0.02

# Frontend build-time public IDs (not secrets)
VITE_WALLETCONNECT_PROJECT_ID=your_reown_project_id
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Development only: browser admin access without Telegram initData
ALLOW_LOCAL_ADMIN=false
LOCAL_ADMIN_TELEGRAM_ID=1
